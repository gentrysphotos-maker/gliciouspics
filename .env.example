# ───────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and replace each REPLACE_ME with a real value.
# Never commit .env. The placeholders here intentionally use REPLACE_ME
# so it's obvious if you forgot to swap one out.
# ───────────────────────────────────────────────────────────────────────

# Stripe — test mode for development, switch to live keys at launch.
# Source: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=REPLACE_ME_sk_test_xxx
STRIPE_PUBLISHABLE_KEY=REPLACE_ME_pk_test_xxx

# Stripe webhook signing secret.
#
# IMPORTANT: Stripe webhook endpoints and their signing secrets are PER-MODE.
# The endpoint you created in test mode does not exist in live mode, and its
# whsec_ will never validate a live signature. When you switch to live keys you
# MUST also create a live-mode endpoint and paste ITS signing secret here —
# otherwise payments succeed and no order is ever fulfilled.
#
#   - Local dev:  run `stripe listen --forward-to localhost:8080/api/webhooks/stripe`
#                 and paste the whsec_... it prints.
#   - Local mock: set to `whsec_placeholder` to bypass signature checks
#                 for scratch/test_webhook.js (only works when NODE_ENV != production).
#   - Production: Stripe Dashboard → toggle to the correct MODE → Developers →
#                 Webhooks → your endpoint → Signing secret.
#
# Verify with `npm run preflight`, which checks that an endpoint actually exists
# in the same mode as your secret key.
STRIPE_WEBHOOK_SECRET=REPLACE_ME_whsec_xxx

# Resend transactional email (optional in dev — emails save to temp_emails/
# locally if not set). Source: https://resend.com/api-keys
# Domain must be verified in Resend before sending to customers.
RESEND_API_KEY=REPLACE_ME_re_xxx
# Optional override; default is G.Licious Pics <orders@gliciouspics.com>
# RESEND_FROM_EMAIL=G.Licious Pics <orders@gliciouspics.com>
OWNER_EMAIL=gentrysphotos@example.com

# Prodigi Print API — sandbox key for testing, live key for production.
#   - Sign up at https://dashboard.prodigi.com (this creates BOTH a Live and
#     a Sandbox account automatically).
#   - Get your sandbox API key from https://sandbox-beta-dashboard.pwinty.com
#     (Settings / API). Sandbox keys are opaque strings — no fixed prefix.
#   - Sandbox orders are never produced or charged.
PRODIGI_API_KEY=REPLACE_ME_sandbox_key

# Prodigi API base URL.
#   - Sandbox:     https://api.sandbox.prodigi.com/v4.0   (use for development)
#   - Production:  https://api.prodigi.com/v4.0           (use for live orders)
#
# NOTE: if this variable is UNSET the code defaults to PRODUCTION, not sandbox.
# Always set it explicitly so the environment is never a matter of inference.
# A live Stripe key paired with this sandbox URL accepts real customer orders
# into the sandbox: they are never printed and never appear in the live Prodigi
# dashboard. `npm run preflight` fails on that combination.
PRODIGI_API_URL=https://api.sandbox.prodigi.com/v4.0

# Canonical public site URL. Used for Stripe's post-payment redirect and for
# links inside order emails. Never derived from request headers, which a client
# controls.
SITE_URL=https://gliciouspics.com

# Optional: out-of-band failure alerts. A Slack or Discord incoming-webhook URL
# that receives a POST whenever an order stage fails. Deliberately separate from
# email, because email is the thing most likely to be broken.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Optional: where paid-order JSON records are written. The container filesystem
# is ephemeral on Railway, so point this at a mounted volume if you want the
# files to survive a redeploy. The [ORDER_RECORD] log line is written either way.
# ORDER_STORE_DIR=/data/order-records

# Optional request timeouts (milliseconds).
# PRODIGI_TIMEOUT_MS=15000
# RESEND_TIMEOUT_MS=10000

# Express server port. Railway injects PORT automatically in production;
# this is only used for local dev.
PORT=8080

# NODE_ENV controls dev-only behavior (e.g. saving order JSON to orders/
# on disk, bypassing webhook signature with whsec_placeholder).
# Railway sets this to "production" automatically — leave unset locally.
# NODE_ENV=production
